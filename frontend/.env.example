# ==============================================================================
# Academia-Industry Collaboration Platform - Frontend Environment Configuration
# IMPORTANT: VITE_* variables are bundled into the client and are PUBLIC.
# Never include secrets, tokens, or credentials here.
# ==============================================================================

# API base URL for the backend API.
# In production with Nginx reverse proxy (same origin): use /api/v1
# In production with separate API domain: use https://api.yourdomain.com/api/v1
# Default fallback in code: /api/v1
VITE_API_BASE_URL=/api/v1
