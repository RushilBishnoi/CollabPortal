{
  "name": "academia-industry-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Portal for Academia-Industry Collaboration for Skill Mapping, Internships and Placement",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:backend": "npm run typecheck --workspace=backend",
    "typecheck:frontend": "npm run typecheck --workspace=frontend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "prisma:generate": "npm run prisma:generate --workspace=backend"
  },
  "keywords": [
    "academia-industry",
    "skill-mapping",
    "internships",
    "placement",
    "education"
  ],
  "author": "CollabPortal Team",
  "license": "UNLICENSED"
}
