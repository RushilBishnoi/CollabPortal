# ==============================================================================
# Academia-Industry Collaboration Platform - Environment Configuration Template
# (Do NOT commit real secrets to version control)
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL / Supabase)
# DATABASE_URL: In production, use the Supabase Transaction Pooler (port 6543) for serverless runtime queries.
# Append parameters if needed for PgBouncer: ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academia_industry_portal?schema=public"

# DIRECT_URL: In production, use the Supabase Direct / Session connection (port 5432) for Prisma CLI migrations.
# In local development, DIRECT_URL can be identical to DATABASE_URL or left pointing to local PostgreSQL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/academia_industry_portal?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_LONG_RANDOM_SECRET"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_LONG_REFRESH_SECRET"
JWT_REFRESH_EXPIRATION="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Storage Configuration (S3-compatible / Local fallback)
STORAGE_DRIVER=local
STORAGE_BUCKET="academia-industry-docs"
STORAGE_REGION="us-east-1"
# STORAGE_ENDPOINT="http://localhost:9000"
# STORAGE_ACCESS_KEY="minioadmin"
# STORAGE_SECRET_KEY="minioadmin"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
