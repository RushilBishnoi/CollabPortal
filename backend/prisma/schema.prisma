// Prisma Schema for Academia–Industry Collaboration Platform
// SIH Problem Statement 44
// Source of truth: .antigravity/docs/database-schema.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  FACULTY
  INDUSTRY
  INSTITUTION_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum OpportunityType {
  INTERNSHIP
  JOB
  APPRENTICESHIP
  LIVE_PROJECT
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  SAVED
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum DocumentType {
  RESUME
  TRANSCRIPT
  CERTIFICATE
  OTHER
}

enum InterviewMode {
  ONLINE_MEETING
  IN_PERSON
  TELEPHONIC
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum AssessmentType {
  MULTIPLE_CHOICE
  CODING
  PROJECT_BASED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  TIMED_OUT
  ABANDONED
}

enum CollaborationType {
  GUEST_LECTURE
  WORKSHOP
  FDP
  INDUSTRIAL_TRAINING
  RESEARCH
  CONSULTANCY
  LIVE_PROJECT
}

enum CollaborationStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

enum ParticipationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  COMPLETED
  CANCELLED
}

enum CollaborationAudience {
  FACULTY
  STUDENT
  BOTH
}

enum CollaborationMode {
  ONLINE
  IN_PERSON
  HYBRID
}

enum LearningResourceType {
  VIDEO
  ARTICLE
  DOCUMENTATION
  COURSE
  INTERACTIVE_LAB
  PRACTICE_PROJECT
  BOOK
}

enum LearningResourceDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LearningPathStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StudentResourceStatus {
  SAVED
  IN_PROGRESS
  COMPLETED
}

enum StudentPathEnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

// ─── Post-Selection Placement & Offer Management Enums (Phase 13) ────────────

enum OfferStatus {
  DRAFT
  ISSUED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
  CANCELLED
}

enum PlacementStatus {
  PENDING_VERIFICATION
  VERIFIED
  CONFIRMED
  JOINED
  REVOKED
}

enum PlacementDocumentType {
  OFFER_LETTER
  JOINING_LETTER
  PAYSLIP
  NOC
  COMPLETION_CERTIFICATE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP_TO_JOB
  CONTRACT
  INTERNSHIP
}

// ─── Mentorship & Mentor Engagement (Phase 14 Enums) ─────────────────────────

enum MentorRoleType {
  INDUSTRY
  FACULTY
}

enum MentorshipRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum MentorshipStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum MentorshipSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum MentorshipGoalStatus {
  PENDING
  IN_PROGRESS
  ACHIEVED
  CANCELLED
}

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  passwordHash        String
  role                UserRole
  status              UserStatus   @default(ACTIVE)
  isEmailVerified     Boolean      @default(false)
  emailVerifiedAt     DateTime?
  avatarUrl           String?
  lastLoginAt         DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]

  studentProfile      StudentProfile?
  facultyProfile      FacultyProfile?
  industryProfile     IndustryProfile?
  institutionProfile  InstitutionProfile?
  mentorProfile       MentorProfile?
  notifications       Notification[]
  notificationPreferences NotificationPreference[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model InstitutionProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  name            String
  code            String?  @unique
  type            String   @default("UNIVERSITY")
  address         String?
  city            String?
  state           String?
  website         String?
  contactEmail    String?
  contactPhone    String?
  departments     String[] @default([])
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  students        StudentProfile[]
  facultyMembers  FacultyProfile[]
  placements      Placement[]

  @@index([userId])
  @@index([name])
  @@map("institution_profiles")
}

model StudentProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  fullName           String
  phoneNumber        String?
  bio                String?
  avatarUrl          String?
  institutionId      String?
  degree             String?
  department         String?
  graduationYear     Int?
  cgpa               Float?
  careerInterests    String[] @default([])
  preferredRoles     String[] @default([])
  preferredLocations String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution        InstitutionProfile? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  experiences        StudentExperience[]
  projects           StudentProject[]
  certifications     StudentCertification[]
  studentSkills      StudentSkill[]
  assessmentAttempts AssessmentAttempt[]
  applications       Application[]
  collaborationParticipations CollaborationParticipation[]
  resourceProgress   StudentResourceProgress[]
  pathEnrollments    StudentPathEnrollment[]
  placementOffers    PlacementOffer[]
  placements         Placement[]
  mentorshipRequests MentorshipRequest[]
  mentorships        Mentorship[]
  mentorshipSessions MentorshipSession[]

  @@index([userId])
  @@index([institutionId])
  @@map("student_profiles")
}

// ─── Skill Taxonomy ────────────────────────────────────────────────────────────

model SkillCategory {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  parentId    String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  parent      SkillCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    SkillCategory[] @relation("CategoryHierarchy")
  skills      Skill[]

  @@index([parentId])
  @@index([isActive])
  @@map("skill_categories")
}

model Skill {
  id          String        @id @default(uuid())
  name        String
  description String?
  categoryId  String
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category      SkillCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  studentSkills StudentSkill[]
  assessments   Assessment[]
  careerRoleSkills CareerRoleSkill[]
  opportunitySkills OpportunitySkill[]
  learningResources LearningResource[]
  mentorSkills      MentorSkill[]
  mentorshipGoals   MentorshipGoal[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@index([name])
  @@index([isActive])
  @@map("skills")
}

model StudentSkill {
  id               String             @id @default(uuid())
  studentProfileId String
  skillId          String
  proficiency      ProficiencyLevel
  score            Int?               // Optional 0-100 numeric score (populated by assessments later)
  source           String             @default("SELF_REPORTED") // SELF_REPORTED | ASSESSMENT | VERIFIED
  verificationStatus VerificationStatus @default(PENDING)
  lastAssessedAt   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  studentProfile   StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill            Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, skillId])
  @@index([studentProfileId])
  @@index([skillId])
  @@index([verificationStatus])
  @@map("student_skills")
}

// ─── Assessment Engine ─────────────────────────────────────────────────────────

model Assessment {
  id              String             @id @default(uuid())
  title           String
  description     String?
  skillId         String
  type            AssessmentType     @default(MULTIPLE_CHOICE)
  passingScore    Int                @default(70) // Percentage score needed to pass (e.g. 70%)
  durationMinutes Int                @default(20) // Timed window in minutes
  totalQuestions  Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  skill           Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  questions       AssessmentQuestion[]
  attempts        AssessmentAttempt[]

  @@index([skillId])
  @@index([isActive])
  @@map("assessments")
}

model AssessmentQuestion {
  id           String           @id @default(uuid())
  assessmentId String
  questionText String
  explanation  String?          // Educational explanation revealed after grading
  points       Int              @default(1)
  order        Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options      QuestionOption[]
  answers      AttemptAnswer[]

  @@index([assessmentId])
  @@map("assessment_questions")
}

model QuestionOption {
  id          String             @id @default(uuid())
  questionId  String
  optionText  String
  isCorrect   Boolean            @default(false)
  order       Int                @default(1)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  question    AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers     AttemptAnswer[]

  @@index([questionId])
  @@map("question_options")
}

model AssessmentAttempt {
  id               String             @id @default(uuid())
  studentProfileId String
  assessmentId     String
  status           AttemptStatus      @default(IN_PROGRESS)
  score            Float?             // Percentage score (0 - 100)
  passed           Boolean?
  totalPoints      Int?
  earnedPoints     Int?
  startedAt        DateTime           @default(now())
  submittedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  studentProfile   StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assessment       Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers          AttemptAnswer[]

  @@index([studentProfileId])
  @@index([assessmentId])
  @@index([status])
  @@map("assessment_attempts")
}

model AttemptAnswer {
  id               String             @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean?
  earnedPoints     Int?               @default(0)
  answeredAt       DateTime           @default(now())

  attempt          AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuestionOption?    @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("attempt_answers")
}

// ─── Career Roles & Skill Requirements (Phase 7) ──────────────────────────────

model CareerRole {
  id                 String            @id @default(uuid())
  title              String
  slug               String            @unique
  description        String?
  category           String            // e.g. "Software Engineering", "Cloud & DevOps", "Data & AI"
  minExperienceYears Int               @default(0)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  skills             CareerRoleSkill[]
  opportunities      Opportunity[]
  learningPaths      LearningPath[]
  mentorCareerRoles  MentorCareerRole[]
  mentorshipRequests MentorshipRequest[]

  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@map("career_roles")
}

model CareerRoleSkill {
  id                  String           @id @default(uuid())
  careerRoleId        String
  skillId             String
  requiredProficiency ProficiencyLevel
  weight              Float            @default(1.0)
  isMandatory         Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  careerRole          CareerRole       @relation(fields: [careerRoleId], references: [id], onDelete: Cascade)
  skill               Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([careerRoleId, skillId])
  @@index([careerRoleId])
  @@index([skillId])
  @@map("career_role_skills")
}

// ─── Opportunities & Matching (Phase 8) ───────────────────────────────────────

model Opportunity {
  id                  String             @id @default(uuid())
  industryProfileId   String
  careerRoleId        String?
  title               String
  slug                String             @unique
  description         String
  opportunityType     OpportunityType    @default(INTERNSHIP)
  status              OpportunityStatus  @default(PUBLISHED)
  location            String             @default("Remote")
  isRemote            Boolean            @default(false)
  stipend             Float?
  stipendCurrency     String             @default("INR")
  stipendPeriod       String             @default("MONTHLY") // MONTHLY | LUMPSUM | PERFORMANCE_BASED | UNPAID
  minCgpa             Float?
  minGraduationYear   Int?
  maxGraduationYear   Int?
  eligibleDepartments String[]           @default([])
  deadline            DateTime?
  positionsCount      Int                @default(1)
  maxApplications     Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  industryProfile     IndustryProfile    @relation(fields: [industryProfileId], references: [id], onDelete: Cascade)
  careerRole          CareerRole?        @relation(fields: [careerRoleId], references: [id], onDelete: SetNull)
  skills              OpportunitySkill[]
  applications        Application[]
  placementOffers     PlacementOffer[]

  @@index([industryProfileId])
  @@index([careerRoleId])
  @@index([opportunityType])
  @@index([status])
  @@index([isRemote])
  @@index([slug])
  @@map("opportunities")
}

model OpportunitySkill {
  id                  String           @id @default(uuid())
  opportunityId       String
  skillId             String
  requiredProficiency ProficiencyLevel
  weight              Float            @default(1.0)
  isMandatory         Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  opportunity         Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill               Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, skillId])
  @@index([opportunityId])
  @@index([skillId])
  @@map("opportunity_skills")
}

// ─── Applications & Recruitment Pipeline (Phase 9) ────────────────────────────

model Application {
  id                     String                    @id @default(uuid())
  opportunityId          String
  studentProfileId       String
  status                 ApplicationStatus         @default(APPLIED)
  coverLetter            String?
  
  // Phase 8 Deterministic Match Snapshot (Immutable at submission)
  matchScoreSnapshot     Float
  matchBreakdownSnapshot Json
  
  // Recruiter Internal Fields (Private)
  recruiterNotes         String?
  rejectionReason        String?
  
  // Timestamps
  submittedAt            DateTime                  @default(now())
  reviewedAt             DateTime?
  decidedAt              DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  opportunity            Opportunity               @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  studentProfile         StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  documents              ApplicationDocument[]
  statusHistory          ApplicationStatusHistory[]
  interviews             Interview[]
  placementOffer         PlacementOffer?

  @@unique([studentProfileId, opportunityId])
  @@index([opportunityId])
  @@index([studentProfileId])
  @@index([status])
  @@index([submittedAt])
  @@map("applications")
}

model ApplicationDocument {
  id               String       @id @default(uuid())
  applicationId    String
  documentType     DocumentType @default(RESUME)
  originalFilename String
  mimeType         String
  sizeBytes        Int
  storageKey       String       @unique
  createdAt        DateTime     @default(now())

  application      Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([storageKey])
  @@map("application_documents")
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedByRole String
  changedById   String
  notes         String?
  createdAt     DateTime          @default(now())

  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([createdAt])
  @@map("application_status_history")
}

model Interview {
  id             String          @id @default(uuid())
  applicationId  String
  title          String
  scheduledAt    DateTime
  durationMins   Int             @default(45)
  mode           InterviewMode   @default(ONLINE_MEETING)
  meetingLink    String?
  interviewer    String?
  instructions   String?
  status         InterviewStatus @default(SCHEDULED)
  recruiterNotes String?
  rating         Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  application    Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
  @@map("interviews")
}

model StudentExperience {
  id               String         @id @default(uuid())
  studentProfileId String
  title            String
  company          String
  location         String?
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean        @default(false)
  description      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@map("student_experiences")
}

model StudentProject {
  id               String         @id @default(uuid())
  studentProfileId String
  title            String
  description      String
  repoUrl          String?
  demoUrl          String?
  technologies     String[]       @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@map("student_projects")
}

model StudentCertification {
  id                  String         @id @default(uuid())
  studentProfileId    String
  name                String
  issuingOrganization String
  issueDate           DateTime
  credentialUrl       String?
  credentialId        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  studentProfile      StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@map("student_certifications")
}

model FacultyProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  fullName           String
  phoneNumber        String?
  designation        String?
  department         String?
  institutionId      String?
  academicBackground String?
  areasOfExpertise   String[]            @default([])
  researchInterests  String[]            @default([])
  industryInterests  String[]            @default([])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution        InstitutionProfile? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  collaborationParticipations CollaborationParticipation[]

  @@index([userId])
  @@index([institutionId])
  @@map("faculty_profiles")
}

model IndustryProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  companyName  String
  industryType String
  description  String?
  website      String?
  companySize  String?
  headquarters String?
  contactEmail String?
  contactPhone String?
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  collaborations Collaboration[]
  placementOffers PlacementOffer[]
  placements   Placement[]

  @@index([userId])
  @@index([companyName])
  @@map("industry_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemHealthLog {
  id        String   @id @default(uuid())
  status    String
  uptime    Float
  version   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("system_health_logs")
}

// ─── Academia–Industry Collaboration (Phase 11) ────────────────────────────────

model Collaboration {
  id                  String                @id @default(uuid())
  industryProfileId   String
  title               String
  description         String
  collaborationType   CollaborationType     @default(WORKSHOP)
  status              CollaborationStatus   @default(DRAFT)
  targetAudience      CollaborationAudience @default(BOTH)
  mode                CollaborationMode     @default(ONLINE)
  startDate           DateTime?
  endDate             DateTime?
  durationDays        Int?
  sessionCount        Int?
  location            String?
  meetingLink         String?
  maxParticipants     Int?
  eligibleDepartments String[]              @default([])
  domainTags          String[]              @default([])
  stipend             Float?
  stipendCurrency     String                @default("INR")
  contactPerson       String?
  contactEmail        String?
  instructions        String?
  deadline            DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  industryProfile     IndustryProfile       @relation(fields: [industryProfileId], references: [id], onDelete: Cascade)
  participations      CollaborationParticipation[]

  @@index([industryProfileId])
  @@index([collaborationType])
  @@index([status])
  @@index([targetAudience])
  @@index([mode])
  @@index([deadline])
  @@index([startDate])
  @@map("collaborations")
}

model CollaborationParticipation {
  id                 String                     @id @default(uuid())
  collaborationId    String
  facultyProfileId   String?
  studentProfileId   String?
  status             ParticipationStatus        @default(PENDING)
  motivation         String?
  relevantExperience String?
  industryNotes      String?
  rejectionReason    String?
  requestedAt        DateTime                   @default(now())
  decidedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  collaboration      Collaboration              @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  facultyProfile     FacultyProfile?            @relation(fields: [facultyProfileId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile?            @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  statusHistory      CollaborationStatusHistory[]

  @@unique([collaborationId, facultyProfileId])
  @@unique([collaborationId, studentProfileId])
  @@index([collaborationId])
  @@index([facultyProfileId])
  @@index([studentProfileId])
  @@index([status])
  @@index([requestedAt])
  @@map("collaboration_participations")
}

model CollaborationStatusHistory {
  id              String                     @id @default(uuid())
  participationId String
  fromStatus      ParticipationStatus?
  toStatus        ParticipationStatus
  changedByRole   String
  changedById     String
  notes           String?
  createdAt       DateTime                   @default(now())

  participation   CollaborationParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@index([participationId])
  @@index([createdAt])
  @@map("collaboration_status_history")
}

// ─── Curated Learning Resources & Guided Learning Paths (Phase 12) ───────────

model LearningResource {
  id                String                     @id @default(uuid())
  title             String
  slug              String                     @unique
  description       String
  url               String
  resourceType      LearningResourceType       @default(ARTICLE)
  difficulty        LearningResourceDifficulty @default(BEGINNER)
  estimatedMinutes  Int                        @default(30)
  skillId           String
  targetProficiency ProficiencyLevel           @default(BEGINNER)

  // Author Attribution
  authorRole        UserRole
  authorUserId      String
  isVerified        Boolean                    @default(false)
  isPublished       Boolean                    @default(true)

  // Metadata
  provider          String?
  tags              String[]                   @default([])
  rating            Float?                     @default(5.0)
  ratingCount       Int                        @default(0)

  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  skill             Skill                      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  pathItems         LearningPathItem[]
  studentProgress   StudentResourceProgress[]

  @@index([skillId])
  @@index([resourceType])
  @@index([difficulty])
  @@index([authorRole])
  @@index([isPublished])
  @@index([slug])
  @@map("learning_resources")
}

model LearningPath {
  id                String                      @id @default(uuid())
  title             String
  slug              String                      @unique
  description       String
  careerRoleId      String?
  targetProficiency ProficiencyLevel            @default(INTERMEDIATE)
  status            LearningPathStatus          @default(PUBLISHED)
  estimatedHours    Int                         @default(10)

  // Author Attribution
  authorRole        UserRole
  authorUserId      String
  institutionId     String?

  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  careerRole        CareerRole?                 @relation(fields: [careerRoleId], references: [id], onDelete: SetNull)
  items             LearningPathItem[]
  enrollments       StudentPathEnrollment[]
  mentorshipGoals   MentorshipGoal[]

  @@index([careerRoleId])
  @@index([status])
  @@index([authorRole])
  @@index([slug])
  @@map("learning_paths")
}

model LearningPathItem {
  id             String           @id @default(uuid())
  learningPathId String
  resourceId     String
  order          Int              @default(1)
  isMandatory    Boolean          @default(true)
  milestoneNotes String?
  createdAt      DateTime         @default(now())

  learningPath   LearningPath     @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  resource       LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, resourceId])
  @@unique([learningPathId, order])
  @@index([learningPathId])
  @@index([resourceId])
  @@map("learning_path_items")
}

model StudentResourceProgress {
  id               String                @id @default(uuid())
  studentProfileId String
  resourceId       String
  status           StudentResourceStatus @default(SAVED)
  timeSpentMinutes Int                   @default(0)
  rating           Int?
  notes            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  studentProfile   StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  resource         LearningResource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, resourceId])
  @@index([studentProfileId])
  @@index([resourceId])
  @@index([status])
  @@map("student_resource_progress")
}

model StudentPathEnrollment {
  id                  String                      @id @default(uuid())
  studentProfileId    String
  learningPathId      String
  status              StudentPathEnrollmentStatus @default(ENROLLED)
  progressPercentage  Float                       @default(0.0)
  completedItemsCount Int                         @default(0)
  totalItemsCount     Int                         @default(0)
  startedAt           DateTime                    @default(now())
  completedAt         DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  studentProfile      StudentProfile              @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  learningPath        LearningPath                @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, learningPathId])
  @@index([studentProfileId])
  @@index([learningPathId])
  @@index([status])
  @@map("student_path_enrollments")
}

// ─── Post-Selection Placement & Offer Management (Phase 13) ─────────────────

model PlacementOffer {
  id                    String            @id @default(uuid())
  applicationId         String            @unique
  opportunityId         String
  studentProfileId      String
  industryProfileId     String
  
  // Offer Details
  title                 String
  designation           String
  employmentType        EmploymentType    @default(FULL_TIME)
  status                OfferStatus       @default(DRAFT)
  
  // Compensation & Benefits (Numeric INR values)
  ctcAnnual             Float?            // Cost to Company (Annual in INR)
  baseSalaryMonthly     Float?            // Monthly Base (INR)
  stipendMonthly        Float?            // For Internship / Stipend
  currency              String            @default("INR")
  
  // Logistics & Schedule
  joiningDate           DateTime
  offerExpiryDate       DateTime
  workLocation          String            @default("Remote")
  workMode              String            @default("IN_PERSON") // IN_PERSON | REMOTE | HYBRID
  department            String?           // Corporate department / team
  
  // Offer Terms & Conditions
  description           String?
  termsAndConditions    String?
  benefitsSummary       String?
  
  // Signatory & Contact
  contactPerson         String?
  contactEmail          String?
  
  // Student Response Metadata
  studentResponseAt     DateTime?
  studentDeclineReason  String?
  studentNotes          String?
  
  // Timestamps
  issuedAt              DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  application           Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  opportunity           Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  studentProfile        StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  industryProfile       IndustryProfile   @relation(fields: [industryProfileId], references: [id], onDelete: Cascade)
  
  placement             Placement?
  documents             PlacementDocument[]
  statusHistory         OfferStatusHistory[]

  @@index([applicationId])
  @@index([studentProfileId])
  @@index([industryProfileId])
  @@index([opportunityId])
  @@index([status])
  @@index([offerExpiryDate])
  @@map("placement_offers")
}

model Placement {
  id                    String            @id @default(uuid())
  offerId               String            @unique
  studentProfileId      String
  institutionId         String?
  industryProfileId     String
  
  status                PlacementStatus   @default(PENDING_VERIFICATION)
  
  // Institution TPO Verification
  verifiedByUserId      String?
  verifiedAt            DateTime?
  verificationNotes     String?
  nocIssued             Boolean           @default(false)
  nocReferenceNumber    String?
  
  // Joining Confirmation
  joiningConfirmed      Boolean           @default(false)
  joiningConfirmedAt    DateTime?
  actualJoiningDate     DateTime?
  
  // Snapshot data for institutional reporting
  annualCtcSnapshot     Float?
  companyNameSnapshot   String
  jobTitleSnapshot      String
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  offer                 PlacementOffer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  studentProfile        StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  institution           InstitutionProfile? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  industryProfile       IndustryProfile   @relation(fields: [industryProfileId], references: [id], onDelete: Cascade)
  
  statusHistory         PlacementStatusHistory[]
  documents             PlacementDocument[]

  @@index([offerId])
  @@index([studentProfileId])
  @@index([institutionId])
  @@index([industryProfileId])
  @@index([status])
  @@map("placements")
}

model PlacementDocument {
  id               String                @id @default(uuid())
  offerId          String?
  placementId      String?
  documentType     PlacementDocumentType @default(OFFER_LETTER)
  originalFilename String
  mimeType         String
  sizeBytes        Int
  storageKey       String                @unique
  uploadedByRole   UserRole
  uploadedByUserId String
  createdAt        DateTime              @default(now())

  offer            PlacementOffer?       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  placement        Placement?            @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([placementId])
  @@index([storageKey])
  @@map("placement_documents")
}

model OfferStatusHistory {
  id            String       @id @default(uuid())
  offerId       String
  fromStatus    OfferStatus?
  toStatus      OfferStatus
  changedByRole String
  changedById   String
  notes         String?
  createdAt     DateTime     @default(now())

  offer         PlacementOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([createdAt])
  @@map("offer_status_history")
}

model PlacementStatusHistory {
  id            String           @id @default(uuid())
  placementId   String
  fromStatus    PlacementStatus?
  toStatus      PlacementStatus
  changedByRole String
  changedById   String
  notes         String?
  createdAt     DateTime         @default(now())

  placement     Placement        @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([placementId])
  @@index([createdAt])
  @@map("placement_status_history")
}

// ─── Mentorship & Mentor Engagement (Phase 14 Models) ────────────────────────

model MentorProfile {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  mentorRoleType         MentorRoleType     @default(INDUSTRY)
  headline               String
  bio                    String
  designation            String
  companyOrInstitution   String
  yearsOfExperience      Int                @default(1)
  maxMentees             Int                @default(5)
  isAvailable            Boolean            @default(true)
  defaultMeetingPlatform String             @default("GOOGLE_MEET") // GOOGLE_MEET | ZOOM | MS_TEAMS | IN_PERSON
  defaultMeetingLink     String?
  linkedInUrl            String?
  githubUrl              String?
  totalSessionsCompleted Int                @default(0)
  averageRating          Float              @default(0.0)
  ratingCount            Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                 MentorSkill[]
  careerRoles            MentorCareerRole[]
  availabilities         MentorAvailability[]
  mentorshipRequests     MentorshipRequest[]
  mentorships            Mentorship[]
  sessions               MentorshipSession[]

  @@index([userId])
  @@index([mentorRoleType])
  @@index([isAvailable])
  @@index([averageRating])
  @@map("mentor_profiles")
}

model MentorSkill {
  id              String        @id @default(uuid())
  mentorProfileId String
  skillId         String
  createdAt       DateTime      @default(now())

  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([mentorProfileId, skillId])
  @@index([mentorProfileId])
  @@index([skillId])
  @@map("mentor_skills")
}

model MentorCareerRole {
  id              String        @id @default(uuid())
  mentorProfileId String
  careerRoleId    String
  createdAt       DateTime      @default(now())

  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  careerRole      CareerRole    @relation(fields: [careerRoleId], references: [id], onDelete: Cascade)

  @@unique([mentorProfileId, careerRoleId])
  @@index([mentorProfileId])
  @@index([careerRoleId])
  @@map("mentor_career_roles")
}

model MentorAvailability {
  id               String        @id @default(uuid())
  mentorProfileId  String
  dayOfWeek        Int           // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime        String        // "14:00" (24-hour format)
  endTime          String        // "18:00"
  slotDurationMins Int           @default(45)
  isRecurring      Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  mentorProfile    MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  @@index([mentorProfileId])
  @@index([dayOfWeek])
  @@map("mentor_availabilities")
}

model MentorshipRequest {
  id                    String                  @id @default(uuid())
  mentorProfileId       String
  studentProfileId      String
  status                MentorshipRequestStatus @default(PENDING)
  statementOfPurpose    String
  targetCareerRoleId    String?
  expectedDurationWeeks Int                     @default(8)
  rejectionReason       String?
  mentorResponseNotes   String?
  respondedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  mentorProfile         MentorProfile           @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  studentProfile        StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  targetCareerRole      CareerRole?             @relation(fields: [targetCareerRoleId], references: [id], onDelete: SetNull)
  mentorship            Mentorship?

  @@index([mentorProfileId])
  @@index([studentProfileId])
  @@index([status])
  @@map("mentorship_requests")
}

model Mentorship {
  id                 String           @id @default(uuid())
  requestId          String           @unique
  mentorProfileId    String
  studentProfileId   String
  status             MentorshipStatus @default(ACTIVE)
  startDate          DateTime         @default(now())
  endDate            DateTime?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  request            MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  mentorProfile      MentorProfile    @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  goals              MentorshipGoal[]
  sessions           MentorshipSession[]

  @@index([mentorProfileId])
  @@index([studentProfileId])
  @@index([status])
  @@map("mentorships")
}

model MentorshipGoal {
  id                   String               @id @default(uuid())
  mentorshipId         String
  title                String
  description          String?
  targetDate           DateTime?
  status               MentorshipGoalStatus @default(PENDING)
  linkedSkillId        String?
  linkedLearningPathId String?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  mentorship           Mentorship           @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  linkedSkill          Skill?               @relation(fields: [linkedSkillId], references: [id], onDelete: SetNull)
  linkedLearningPath   LearningPath?        @relation(fields: [linkedLearningPathId], references: [id], onDelete: SetNull)

  @@index([mentorshipId])
  @@index([status])
  @@map("mentorship_goals")
}

model MentorshipSession {
  id                 String                  @id @default(uuid())
  mentorshipId       String?
  mentorProfileId    String
  studentProfileId   String
  title              String
  description        String?
  scheduledAt        DateTime
  durationMinutes    Int                     @default(45)
  status             MentorshipSessionStatus @default(SCHEDULED)
  meetingPlatform    String                  @default("GOOGLE_MEET")
  meetingLink        String?
  location           String?
  
  // Feedback & Notes
  mentorNotes        String?                 // Private to mentor
  studentNotes       String?                 // Private to student
  sharedSummary      String?                 // Visible to both
  studentRating      Int?                    // 1 to 5
  studentFeedback    String?
  cancellationReason String?
  cancelledByRole    UserRole?
  
  completedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  mentorship         Mentorship?             @relation(fields: [mentorshipId], references: [id], onDelete: SetNull)
  mentorProfile      MentorProfile           @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([mentorProfileId])
  @@index([studentProfileId])
  @@index([mentorshipId])
  @@index([scheduledAt])
  @@index([status])
  @@map("mentorship_sessions")
}

// ─── Notifications & Communication System (Phase 15) ──────────────────────────

enum NotificationType {
  // Recruitment & Applications (Phases 8 & 9)
  APPLICATION_SUBMITTED
  APPLICATION_STATUS_CHANGED
  APPLICATION_SHORTLISTED
  APPLICATION_SELECTED
  APPLICATION_REJECTED
  INTERVIEW_SCHEDULED
  INTERVIEW_UPDATED
  OPPORTUNITY_PUBLISHED

  // Collaboration (Phase 11)
  COLLABORATION_PARTICIPATION_REQUESTED
  COLLABORATION_PARTICIPATION_APPROVED
  COLLABORATION_PARTICIPATION_REJECTED
  COLLABORATION_STATUS_CHANGED

  // Learning & Remediation (Phase 12)
  LEARNING_PATH_ENROLLED
  LEARNING_PATH_COMPLETED
  SKILL_GAP_REMEDIATION_AVAILABLE

  // Placement & Offers (Phase 13)
  PLACEMENT_OFFER_ISSUED
  PLACEMENT_OFFER_ACCEPTED
  PLACEMENT_OFFER_DECLINED
  PLACEMENT_VERIFICATION_REQUIRED
  PLACEMENT_VERIFIED
  PLACEMENT_CONFIRMED
  PLACEMENT_JOINED
  PLACEMENT_REVOKED

  // Mentorship (Phase 14)
  MENTOR_REQUEST_RECEIVED
  MENTOR_REQUEST_ACCEPTED
  MENTOR_REQUEST_REJECTED
  MENTORSHIP_STARTED
  MENTORSHIP_SESSION_SCHEDULED
  MENTORSHIP_SESSION_RESCHEDULED
  MENTORSHIP_SESSION_CANCELLED
  MENTORSHIP_SESSION_COMPLETED

  // System
  SYSTEM_ANNOUNCEMENT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id              String               @id @default(uuid())
  recipientUserId String
  type            NotificationType
  priority        NotificationPriority @default(NORMAL)
  title           String
  message         String
  entityType      String?              // "APPLICATION" | "INTERVIEW" | "OPPORTUNITY" | "COLLABORATION" | "LEARNING_PATH" | "PLACEMENT_OFFER" | "PLACEMENT" | "MENTORSHIP_REQUEST" | "MENTORSHIP_SESSION" | "SYSTEM"
  entityId        String?              // UUID of the referenced target entity
  actionUrl       String?              // Frontend navigation route (e.g. "/portal/student/offers")
  metadata        Json?                // Non-sensitive contextual metadata
  isRead          Boolean              @default(false)
  readAt          DateTime?
  idempotencyKey  String?              @unique // Recipient-aware unique key (e.g. "EVENT:ENTITY:ID:RECIPIENT_USER_ID")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  recipient       User                 @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead])
  @@index([recipientUserId, createdAt])
  @@index([type])
  @@map("notifications")
}

model NotificationPreference {
  id               String           @id @default(uuid())
  userId           String
  notificationType NotificationType
  inAppEnabled     Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType])
  @@index([userId])
  @@map("notification_preferences")
}




